{
	"name": "keepr",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "oxfmt --check && node apps/stream/scripts/slots.mjs lint -- oxlint",
		"lint:fix": "node apps/stream/scripts/slots.mjs lint -- oxlint --fix && oxfmt",
		"format": "oxfmt",
		"verify": "pnpm --filter @keepr/stream verify",
		"verify:quick": "pnpm --filter @keepr/stream verify:quick"
	},
	"devDependencies": {
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.12.1"
		}
	},
	"packageManager": "pnpm@12.15.0"
}
