// Where 1Password keeps each secret's value, and where the value is used: no
// value is ever here (ADR-0134). `pnpm secrets:sync` reads it; what each field
// means: packages/tooling/scripts/secrets/map.mjs.
//
// Each item in the `Keepr` vault is a Secure Note whose concealed fields are
// named after the secret. An empty field is not recorded yet: the sync skips it
// and names it.
{
	"workers": {
		"stream": {
			// The names are apps/stream/deploy.jsonc's `worker.secrets`, plus `optional`;
			// test/secretsMap.test.ts fails when the two disagree.
			"environments": {
				"staging": {
					"NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY": "op://Keepr/stream-staging/NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY",
					"NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY": "op://Keepr/stream-staging/NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY",
					"NUXT_INSTALLATION_ORGANISATION_ID": "op://Keepr/stream-staging/NUXT_INSTALLATION_ORGANISATION_ID",
					"NUXT_BANDAI_KEEPR_API_KEY": "op://Keepr/stream-staging/NUXT_BANDAI_KEEPR_API_KEY"
				},
				"production": {
					"NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY": "op://Keepr/stream-production/NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY",
					"NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY": "op://Keepr/stream-production/NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY",
					"NUXT_INSTALLATION_ORGANISATION_ID": "op://Keepr/stream-production/NUXT_INSTALLATION_ORGANISATION_ID",
					"NUXT_BANDAI_KEEPR_API_KEY": "op://Keepr/stream-production/NUXT_BANDAI_KEEPR_API_KEY"
				}
			},
			// One Piece card data; an Installation without it shows "card data unavailable".
			"optional": ["NUXT_BANDAI_KEEPR_API_KEY"],
			// `--generate <NAME>`: what a new value does to an Installation that has one
			// (apps/stream/README.md § Worker secrets).
			"generate": {
				"NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY": {
					"warn": "a new NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY revokes every Screen Output asset capability: rotate each Screen's asset access before using its output URL"
				},
				"NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY": {
					"refuse": "a new Melee key goes with a Release that bumps the NUXT_MELEE_CREDENTIAL_KEY_VERSION var and keeps the old key in NUXT_MELEE_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS (apps/stream/README.md § Worker secrets), which the sync does not do: rotate it by hand, then record it in 1Password"
				}
			}
		},
		"accounts": {
			// The names are apps/accounts/deploy.jsonc's `worker.secrets`.
			"environments": {
				"staging": {
					"NUXT_BETTER_AUTH_SECRET": "op://Keepr/accounts-staging/NUXT_BETTER_AUTH_SECRET"
				},
				"production": {
					"NUXT_BETTER_AUTH_SECRET": "op://Keepr/accounts-production/NUXT_BETTER_AUTH_SECRET"
				}
			},
			"generate": {
				"NUXT_BETTER_AUTH_SECRET": {
					"warn": "a new NUXT_BETTER_AUTH_SECRET signs every User out of Keepr Accounts, and so out of every App: each signs in again"
				}
			}
		}
	},
	// GitHub environment secrets. The release GitHub App's credentials are the
	// `release` environment's alone.
	"github": {
		"staging": {
			"CLOUDFLARE_API_TOKEN": "op://Keepr/github-staging/CLOUDFLARE_API_TOKEN",
			"STREAM_KEEPR_ACCEPTANCE_OPERATOR_EMAIL": "op://Keepr/github-staging/STREAM_KEEPR_ACCEPTANCE_OPERATOR_EMAIL",
			"STREAM_KEEPR_ACCEPTANCE_OPERATOR_PASSWORD": "op://Keepr/github-staging/STREAM_KEEPR_ACCEPTANCE_OPERATOR_PASSWORD"
		},
		"production": {
			"CLOUDFLARE_API_TOKEN": "op://Keepr/github-production/CLOUDFLARE_API_TOKEN"
		},
		"release": {
			"KEEPR_RELEASE_APP_ID": "op://Keepr/keepr-release/KEEPR_RELEASE_APP_ID",
			"KEEPR_RELEASE_APP_PRIVATE_KEY": "op://Keepr/keepr-release/KEEPR_RELEASE_APP_PRIVATE_KEY"
		}
	}
}
