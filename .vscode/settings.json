{
	// Oxlint is the linter (`.oxlintrc.json`); its safe fixes apply on save.
	"editor.formatOnSave": false,
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit",
		"source.organizeImports": "never"
	},

	"files.associations": {
		"*.css": "tailwindcss",
		"wrangler.json": "jsonc",
		".oxlintrc.json": "jsonc"
	},

	"editor.quickSuggestions": {
		"strings": "on"
	}
}
