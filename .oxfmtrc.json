{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	// The style the code already had: tabs, semicolons, single quotes. All else is Oxfmt's default.
	"useTabs": true,
	"singleQuote": true,
	"overrides": [
		{
			// A reader that strips comments and hands the rest to `JSON.parse` (apps/stream/test/helpers/miniflare-d1.ts)
			// stops at a trailing comma.
			"files": ["*.jsonc"],
			"options": { "trailingComma": "none" }
		}
	],
	"ignorePatterns": [
		// Prose is wrapped by hand, and each CHANGELOG.md is Changesets'.
		"**/*.md",
		// Generated: pnpm's, Drizzle's, Wrangler's (`pnpm types:app --check` compares it byte for byte).
		"pnpm-lock.yaml",
		"apps/stream/server/db/migrations/**",
		"apps/accounts/server/db/migrations/**",
		"**/worker-configuration.d.ts",
		// Served as they are: the acceptance pages and their fixtures.
		"apps/stream/public/**",
		// A throwaway prototype, kept as it was written.
		"apps/score/docs/prototype-matcher/**",
		// The design tool's own files.
		"apps/stream/.impeccable/**",
		// The validator Worker is redeployed when its fingerprint changes, and the fingerprint hashes its
		// bundle and Docker context byte for byte (packages/tooling/scripts/deploy/fingerprint.mjs). Format
		// it with a change that redeploys it anyway.
		"apps/stream/workers/silent-video-validator/**",
		// A tsconfig that cannot load, on purpose.
		"apps/stream/test/helpers/unloadableTsconfig/**"
	]
}
