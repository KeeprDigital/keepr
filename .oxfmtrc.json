{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	// The style the code already had: tabs, semicolons, single quotes. All else is Oxfmt's default.
	"useTabs": true,
	"singleQuote": true,
	"overrides": [
		{
			// A reader that strips comments and hands the rest to `JSON.parse` (test/helpers/miniflare-d1.ts)
			// stops at a trailing comma.
			"files": ["*.jsonc"],
			"options": { "trailingComma": "none" }
		}
	],
	"ignorePatterns": [
		// Prose is wrapped by hand, and CHANGELOG.md is release-please's.
		"**/*.md",
		// Generated: pnpm's, Drizzle's, Wrangler's (`pnpm types:app --check` compares it byte for byte), release-please's.
		"pnpm-lock.yaml",
		"server/db/migrations/**",
		"**/worker-configuration.d.ts",
		".release-please-manifest.json",
		// Served as they are: the acceptance pages and their fixtures.
		"public/**",
		// The design tool's own files.
		".impeccable/**",
		// The validator Worker is redeployed when its fingerprint changes, and the fingerprint hashes its
		// bundle, Docker context and configuration byte for byte (scripts/deploy-promotion.mjs). Format
		// it with a change that redeploys it anyway.
		"workers/silent-video-validator/**",
		// A tsconfig that cannot load, on purpose.
		"test/helpers/unloadableTsconfig/**"
	]
}
