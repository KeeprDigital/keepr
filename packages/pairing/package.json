{
	"name": "@keepr/pairing",
	"version": "0.0.0",
	"private": true,
	"description": "Pairing Engine: Swiss, Single Elimination, checking hand-made Pairings.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p bench/tsconfig.json",
		"test": "vitest run --testTimeout=30000",
		"bench": "node bench/simulate.ts",
		"bench:check": "node bench/simulate.ts 10001 15 --check && node bench/simulate.ts 20001 15 --check"
	},
	"dependencies": {
		"@keepr/engine-core": "workspace:*"
	},
	"devDependencies": {
		"@keepr/testkit": "workspace:*",
		"@types/node": "catalog:tooling",
		"fast-check": "catalog:test",
		"typescript": "catalog:tooling",
		"vitest": "catalog:test"
	}
}
