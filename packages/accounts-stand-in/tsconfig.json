{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		// Wrangler bundles the Worker, and the layer's files it imports name each other without extensions.
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		// The layer's files it imports are written to the layer's own options, not the packages'.
		"erasableSyntaxOnly": false,
		"exactOptionalPropertyTypes": false,
		"types": ["node"]
	},
	"include": ["src", "test", "vitest.config.ts"]
}
