// Keepr Accounts' deploy descriptor: what is deployed. `@keepr/tooling` does the
// deploying (`pnpm run deploy --app accounts --env production`; README.md §
// Deploying), reading this file from the Release being deployed. Paths are from
// this directory. What each field means: packages/tooling/scripts/deploy/release.mjs.
{
	"app": "accounts",
	// Run once; every Environment deploys what they built.
	"build": ["build", "worker:dry-run", "worker:smoke"],
	"output": ".output",
	"worker": {
		"source": "wrangler.jsonc",
		"config": ".output/server/wrangler.json",
		// The Worker secrets every Installation requires (README.md § Deploying): a
		// deploy refuses one that lacks any (ADR-0128).
		"secrets": ["NUXT_BETTER_AUTH_SECRET"]
	},
	"databases": [{ "binding": "DB" }],
	"environments": {
		"production": { "url": "https://accounts.keepr.digital" },
		// wrangler.jsonc's `env.staging` block, in the staging account.
		"staging": { "url": "https://accounts.keepr-staging.digital", "wranglerEnv": "staging" }
	},
	"parts": {}
}
