{
	"name": "@keepr/accounts",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm db:migrate && nuxt dev",
		"beside": "pnpm build && pnpm db:migrate && wrangler dev --config wrangler.dev.jsonc --name keepr-accounts --assets .output/public --port 8790 .output/server/index.mjs",
		"build": "keepr-slots build -- nuxt build",
		"typecheck": "nuxt prepare && keepr-slots typecheck -- vue-tsc --noEmit && keepr-slots typecheck -- vue-tsc --noEmit -p test/tsconfig.json",
		"test": "vitest run && vitest run --config vitest.nuxt.config.ts",
		"verify": "pnpm typecheck && pnpm test && pnpm build",
		"worker:dry-run": "node scripts/worker-dry-run.mjs",
		"worker:smoke": "keepr-slots worker-smoke -- node scripts/worker-smoke.mjs",
		"deploy": "keepr-deploy deploy --app accounts --env production",
		"deploy:verify": "keepr-deploy verify --app accounts --env production",
		"deploy:status": "keepr-deploy status --app accounts --env production",
		"postinstall": "nuxt prepare",
		"lint": "pnpm --workspace-root lint",
		"lint:fix": "pnpm --workspace-root lint:fix",
		"format": "pnpm --workspace-root format",
		"db:generate": "drizzle-kit generate",
		"claim-first-administrator": "node scripts/claim-first-administrator.mjs",
		"db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc < /dev/null"
	},
	"dependencies": {
		"@keepr/nuxt-layer": "workspace:*",
		"better-auth": "catalog:server",
		"drizzle-orm": "catalog:server",
		"nuxt": "catalog:framework",
		"vue": "catalog:framework",
		"vue-router": "catalog:framework"
	},
	"devDependencies": {
		"@keepr/tooling": "workspace:*",
		"@libsql/client": "catalog:test",
		"@nuxt/test-utils": "catalog:test",
		"@types/node": "catalog:tooling",
		"@vue/test-utils": "catalog:test",
		"drizzle-kit": "catalog:server",
		"happy-dom": "catalog:test",
		"jose": "catalog:server",
		"typescript": "catalog:tooling",
		"vitest": "catalog:test",
		"vue-tsc": "catalog:tooling",
		"wrangler": "catalog:cloudflare"
	}
}
