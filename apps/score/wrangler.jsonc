{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Nitro builds .output/server/wrangler.json from this file, adding the Worker
	// entrypoint, assets, and name. Nothing is deployed yet: no route.
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
	// PROTOTYPE, spike 1 of #1256, never merged: tests that a built Worker
	// reaches a local Worker registered as `keepr-accounts`. Not a decision.
	"services": [{ "binding": "ACCOUNTS", "service": "keepr-accounts" }]
}
