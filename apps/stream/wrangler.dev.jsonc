{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stream-local",
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
	// Binding-only entries intentionally create local Wrangler resources. They
	// have no remote IDs, so local development cannot reach staging/production.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stream-local",
			"migrations_table": "_hub_migrations",
			"migrations_dir": "server/db/migrations/sqlite"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV"
		}
	],
	"r2_buckets": [
		{
			"binding": "GRAPHICS_ASSET_STAGING"
		},
		{
			"binding": "GRAPHICS_ASSET_CANONICAL"
		}
	],
	// Realtime's object (ADR-0137). `nuxt dev` runs in Node and cannot hold the
	// class, so the binding names the Worker the realtime layer starts beside the
	// dev server (`packages/realtime/README.md` § Under nuxt dev).
	"durable_objects": {
		"bindings": [
			{ "name": "REALTIME", "class_name": "RealtimeObject", "script_name": "keepr-realtime-dev" }
		]
	},
	// Keepr Accounts, by its production name (ADR-0113): locally the Accounts
	// Stand-in registers under it, started beside the dev server by `pnpm dev`.
	"services": [{ "binding": "KEEPR_ACCOUNTS", "service": "keepr-accounts" }]
}
