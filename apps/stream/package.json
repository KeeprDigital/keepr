{
	"name": "@keepr/stream",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"verify": "node scripts/verify.mjs",
		"verify:quick": "node scripts/verify.mjs --quick",
		"verify:docs": "vitest run test/unit/docs/documentation.test.ts",
		"build": "node scripts/slots.mjs build -- nuxt build",
		"dev": "node scripts/reap-workerd.mjs && pnpm db:migrate && nuxt dev",
		"dev:bypass": "STREAM_KEEPR_LOCAL_AUTH_BYPASS=true pnpm dev",
		"dev:local": "pnpm dev --host 0.0.0.0",
		"dev:local:bypass": "STREAM_KEEPR_LOCAL_AUTH_BYPASS=true pnpm dev:local",
		"reap": "node scripts/reap-workerd.mjs",
		"slots": "node scripts/slots.mjs",
		"typecheck": "nuxt prepare && pnpm typecheck:app && pnpm typecheck:test && pnpm typecheck:validator",
		"typecheck:app": "pnpm types:app --check && node scripts/slots.mjs typecheck -- vue-tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo",
		"typecheck:test": "node scripts/slots.mjs typecheck -- vue-tsc --noEmit -p tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/test.tsbuildinfo",
		"typecheck:validator": "pnpm types:validator --check && tsc -p workers/silent-video-validator/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/validator.tsbuildinfo",
		"types:app": "wrangler types worker-configuration.d.ts --config wrangler.dev.jsonc --env-file /dev/null",
		"types:validator": "wrangler types --config workers/silent-video-validator/wrangler.jsonc workers/silent-video-validator/worker-configuration.d.ts",
		"preview": "node scripts/reap-workerd.mjs && pnpm build && pnpm db:migrate:local:built && node scripts/stage-preview-secrets.mjs && node scripts/preview-worker.mjs",
		"preview:bypass": "STREAM_KEEPR_LOCAL_AUTH_BYPASS=true pnpm preview",
		"worker:dry-run": "node scripts/worker-dry-run.mjs",
		"worker:smoke": "node scripts/reap-workerd.mjs && node scripts/slots.mjs worker-smoke -- node scripts/worker-smoke.mjs",
		"deploy": "pnpm build && pnpm worker:dry-run && pnpm worker:smoke && pnpm deploy:mark-app pending && pnpm db:migrate:remote && wrangler deploy --config .output/server/wrangler.json && pnpm deploy:verify && pnpm deploy:mark-app deployed",
		"deploy:verify": "node scripts/deploy-verify.mjs",
		"deploy:mark-app": "node scripts/deploy-promotion.mjs mark-app",
		"deploy:status": "node scripts/deploy-promotion.mjs status",
		"deploy:validator": "node scripts/deploy-promotion.mjs deploy-validator",
		"validator:dry-run": "wrangler deploy --dry-run --containers-rollout=none --config workers/silent-video-validator/wrangler.jsonc",
		"postinstall": "nuxt prepare",
		"lint": "pnpm --workspace-root lint",
		"lint:fix": "pnpm --workspace-root lint:fix",
		"format": "pnpm --workspace-root format",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc < /dev/null",
		"db:migrate:local:built": "wrangler d1 migrations apply DB --local --config .output/server/wrangler.json --persist-to .wrangler/state/built-worker",
		"db:migrations:list:remote": "wrangler d1 migrations list DB --remote --config .output/server/wrangler.json",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
		"test": "node scripts/verify.mjs --tests",
		"test:changed": "vitest run --changed origin/main --passWithNoTests && vitest run --config vitest.nuxt.config.ts --changed origin/main --passWithNoTests",
		"test:unit": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"test:nuxt": "vitest --config vitest.nuxt.config.ts",
		"test:nuxt:coverage": "vitest run --config vitest.nuxt.config.ts --coverage",
		"test:local-auth": "vitest run --config vitest.local-auth.config.ts",
		"test:integration": "vitest --config vitest.integration.config.ts",
		"accept": "node scripts/accept.mjs"
	},
	"dependencies": {
		"@fontsource/arimo": "catalog:",
		"@fontsource/barlow-condensed": "catalog:",
		"@fontsource/ibm-plex-sans": "catalog:",
		"@fontsource/inter": "catalog:",
		"@fontsource/jetbrains-mono": "catalog:",
		"@fontsource/montserrat": "catalog:",
		"@fontsource/open-sans": "catalog:",
		"@fontsource/oswald": "catalog:",
		"@fontsource/poppins": "catalog:",
		"@fontsource/roboto": "catalog:",
		"@fontsource/roboto-condensed": "catalog:",
		"@fontsource/saira-condensed": "catalog:",
		"@fontsource/source-serif-4": "catalog:",
		"@jsquash/jpeg": "catalog:",
		"@jsquash/webp": "catalog:",
		"@nuxt/fonts": "catalog:",
		"@nuxt/image": "catalog:",
		"@nuxt/ui": "catalog:",
		"@pinia/nuxt": "catalog:",
		"@vueuse/core": "catalog:",
		"@vueuse/nuxt": "catalog:",
		"ably": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"drizzle-zod": "catalog:",
		"echarts": "catalog:",
		"fontkitten": "catalog:",
		"mana-font": "catalog:",
		"nuxt": "catalog:",
		"nuxt-echarts": "catalog:",
		"pinia": "catalog:",
		"tailwindcss": "catalog:",
		"three": "catalog:",
		"vue": "catalog:",
		"vue-draggable-plus": "catalog:",
		"vue-echarts": "catalog:",
		"vue-router": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/containers": "catalog:",
		"@iconify-json/lucide": "catalog:",
		"@iconify-json/simple-icons": "catalog:",
		"@libsql/client": "catalog:",
		"@nuxt/test-utils": "catalog:",
		"@scryfall/api-types": "catalog:",
		"@types/node": "catalog:",
		"@types/three": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "catalog:",
		"@vue/test-utils": "catalog:",
		"drizzle-kit": "catalog:",
		"esbuild": "catalog:",
		"happy-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"vue-tsc": "catalog:",
		"wrangler": "catalog:",
		"yaml": "catalog:"
	}
}
