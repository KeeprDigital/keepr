{
	"name": "@keepr/stream",
	"version": "3.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"verify": "node scripts/verify.mjs",
		"verify:quick": "node scripts/verify.mjs --quick",
		"verify:docs": "vitest run test/unit/docs/documentation.test.ts",
		"build": "keepr-slots build -- nuxt build",
		"dev": "node scripts/reap.mjs && pnpm db:migrate && nuxt dev",
		"dev:bypass": "STREAM_KEEPR_LOCAL_AUTH_BYPASS=true pnpm dev",
		"dev:local": "pnpm dev --host 0.0.0.0",
		"dev:local:bypass": "STREAM_KEEPR_LOCAL_AUTH_BYPASS=true pnpm dev:local",
		"reap": "node scripts/reap.mjs",
		"slots": "keepr-slots",
		"typecheck": "nuxt prepare && pnpm typecheck:app && pnpm typecheck:test && pnpm typecheck:validator",
		"typecheck:app": "pnpm types:app --check && keepr-slots typecheck -- vue-tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo",
		"typecheck:test": "keepr-slots typecheck -- vue-tsc --noEmit -p tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/test.tsbuildinfo",
		"typecheck:validator": "pnpm types:validator --check && tsc -p workers/silent-video-validator/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/validator.tsbuildinfo",
		"types:app": "wrangler types worker-configuration.d.ts --config wrangler.dev.jsonc --env-file /dev/null",
		"types:validator": "wrangler types --config workers/silent-video-validator/wrangler.jsonc workers/silent-video-validator/worker-configuration.d.ts",
		"preview": "node scripts/reap.mjs && pnpm build && pnpm db:migrate:local:built && node scripts/stage-preview-secrets.mjs && node scripts/preview-worker.mjs",
		"preview:bypass": "STREAM_KEEPR_LOCAL_AUTH_BYPASS=true pnpm preview",
		"worker:dry-run": "node scripts/worker-dry-run.mjs",
		"worker:smoke": "node scripts/reap.mjs && keepr-slots worker-smoke -- node scripts/worker-smoke.mjs",
		"deploy": "keepr-deploy deploy --app stream --env production",
		"deploy:verify": "keepr-deploy verify --app stream --env production",
		"deploy:mark-app": "keepr-deploy mark-app --app stream --env production",
		"deploy:status": "keepr-deploy status --app stream --env production",
		"deploy:validator": "keepr-deploy part validator --app stream --env production",
		"validator:dry-run": "wrangler deploy --dry-run --containers-rollout=none --config workers/silent-video-validator/wrangler.jsonc",
		"postinstall": "nuxt prepare",
		"lint": "pnpm --workspace-root lint",
		"lint:fix": "pnpm --workspace-root lint:fix",
		"format": "pnpm --workspace-root format",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc < /dev/null",
		"db:migrate:local:built": "wrangler d1 migrations apply DB --local --config .output/server/wrangler.json --persist-to .wrangler/state/built-worker",
		"db:migrations:list:remote": "wrangler d1 migrations list DB --remote --config .output/server/wrangler.json",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
		"test": "node scripts/verify.mjs --tests",
		"test:changed": "vitest run --changed origin/main --passWithNoTests && vitest run --config vitest.nuxt.config.ts --changed origin/main --passWithNoTests",
		"test:unit": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"test:nuxt": "vitest --config vitest.nuxt.config.ts",
		"test:nuxt:coverage": "vitest run --config vitest.nuxt.config.ts --coverage",
		"test:local-auth": "vitest run --config vitest.local-auth.config.ts",
		"test:integration": "vitest --config vitest.integration.config.ts",
		"accept": "node scripts/accept.mjs",
		"accept:deployed": "node scripts/accept.mjs deployed"
	},
	"dependencies": {
		"@fontsource/arimo": "catalog:fonts",
		"@fontsource/barlow-condensed": "catalog:fonts",
		"@fontsource/ibm-plex-sans": "catalog:fonts",
		"@fontsource/inter": "catalog:fonts",
		"@fontsource/jetbrains-mono": "catalog:fonts",
		"@fontsource/montserrat": "catalog:fonts",
		"@fontsource/open-sans": "catalog:fonts",
		"@fontsource/oswald": "catalog:fonts",
		"@fontsource/poppins": "catalog:fonts",
		"@fontsource/roboto": "catalog:fonts",
		"@fontsource/roboto-condensed": "catalog:fonts",
		"@fontsource/saira-condensed": "catalog:fonts",
		"@fontsource/source-serif-4": "catalog:fonts",
		"@jsquash/jpeg": "catalog:images",
		"@jsquash/webp": "catalog:images",
		"@keepr/nuxt-layer": "workspace:*",
		"@nuxt/fonts": "catalog:framework",
		"@nuxt/image": "catalog:framework",
		"@nuxt/ui": "catalog:framework",
		"@pinia/nuxt": "catalog:framework",
		"@vueuse/core": "catalog:framework",
		"@vueuse/nuxt": "catalog:framework",
		"ably": "catalog:server",
		"better-auth": "catalog:server",
		"drizzle-orm": "catalog:server",
		"drizzle-zod": "catalog:server",
		"echarts": "catalog:charts",
		"fontkitten": "catalog:fonts",
		"mana-font": "catalog:fonts",
		"nuxt": "catalog:framework",
		"nuxt-echarts": "catalog:charts",
		"pinia": "catalog:framework",
		"tailwindcss": "catalog:framework",
		"three": "catalog:charts",
		"vue": "catalog:framework",
		"vue-draggable-plus": "catalog:framework",
		"vue-echarts": "catalog:charts",
		"vue-router": "catalog:framework",
		"zod": "catalog:server"
	},
	"devDependencies": {
		"@cloudflare/containers": "catalog:cloudflare",
		"@iconify-json/lucide": "catalog:fonts",
		"@iconify-json/simple-icons": "catalog:fonts",
		"@keepr/tooling": "workspace:*",
		"@libsql/client": "catalog:test",
		"@nuxt/test-utils": "catalog:test",
		"@scryfall/api-types": "catalog:server",
		"@types/node": "catalog:tooling",
		"@types/three": "catalog:charts",
		"@vitest/coverage-v8": "catalog:test",
		"@vitest/ui": "catalog:test",
		"@vue/test-utils": "catalog:test",
		"drizzle-kit": "catalog:server",
		"esbuild": "catalog:tooling",
		"happy-dom": "catalog:test",
		"typescript": "catalog:tooling",
		"vitest": "catalog:test",
		"vue-tsc": "catalog:tooling",
		"wrangler": "catalog:cloudflare",
		"yaml": "catalog:test"
	}
}
