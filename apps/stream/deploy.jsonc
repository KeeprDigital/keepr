// Stream Keepr's deploy descriptor: what is deployed. `@keepr/tooling` does the
// deploying (`pnpm run deploy --app stream --env production`; README.md § Deploy),
// reading this file from the Release being deployed. Paths are from this directory.
// What each field means: packages/tooling/scripts/deploy/release.mjs.
{
	"app": "stream",
	// Run once; every Environment deploys what they built.
	"build": ["build", "worker:dry-run", "worker:smoke"],
	// What makes a build the integration suite's (nuxt.config.ts): the build
	// records it when set, and a deploy refuses that build.
	"testFlags": ["STREAM_KEEPR_INTEGRATION"],
	"output": ".output",
	"worker": {
		"source": "wrangler.jsonc",
		"config": ".output/server/wrangler.json",
		// Its name, which nuxt.config.ts gives the build and `env.staging` restates;
		// `pnpm secrets:sync` passes it against wrangler.jsonc for production.
		"name": "stream",
		// The Worker secrets every Installation requires (README.md § Worker secrets): a
		// deploy refuses one that lacks any. NUXT_BANDAI_KEEPR_API_KEY is optional.
		// None is for sign-in: Keepr Accounts holds that secret (ADR-0112).
		"secrets": ["NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY", "NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY"]
	},
	"databases": [{ "binding": "DB" }],
	"environments": {
		"production": { "url": "https://stream.keepr.digital" },
		// wrangler.jsonc's and the validator's `env.staging` blocks, in the staging account.
		"staging": { "url": "https://stream.keepr-staging.digital", "wranglerEnv": "staging" }
	},
	// The acceptance gates: the Deploy workflow's staging job runs them against the
	// Staging Installation once it is verified, with no person present, and never
	// in production (ADR-0129). Every deployed gate, 1–6 of README.md § Deploy day;
	// they sign in to Staging's Keepr Accounts as a staging operator and write to staging.
	"gates": ["accept:deployed"],
	"parts": {
		// The app binds it (SILENT_VIDEO_PLAYBACK_VALIDATOR), so it deploys first,
		// and only when its fingerprint changed.
		"validator": {
			"config": "workers/silent-video-validator/wrangler.jsonc",
			"container": "workers/silent-video-validator/container"
		}
	}
}
