{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Nitro builds .output/server/wrangler.json from this file, adding the Worker
	// entrypoint, assets, and name. Every deployed binding and its production ID
	// is declared here and nowhere else. Wrangler resolves path fields
	// relative to the generated file, so `migrations_dir` climbs back out of
	// .output/server.
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
	// The production hostname. The keepr.digital zone lives on the same
	// Cloudflare account, so wrangler keeps this custom domain attached on
	// every deploy; it was previously attached only in the dashboard, which
	// left the repo unable to name its own installation (#189).
	"routes": [{ "pattern": "stream.keepr.digital", "custom_domain": true }],
	// Throwaway for #1295.
	"durable_objects": { "bindings": [{ "name": "EVENT_REALTIME", "class_name": "EventRealtime" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventRealtime"] }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "26830437-975a-4378-a135-acfc01ea89ae",
			// Production D1 records its applied migrations in this table. Under
			// any other name every migration would replay from 0000 and fail
			// mid-deploy.
			"migrations_table": "_hub_migrations",
			"migrations_dir": "../../server/db/migrations/sqlite"
		}
	],
	// Non-secret configuration. bandai-keepr's API key is the Worker secret
	// NUXT_BANDAI_KEEPR_API_KEY; without it OP card data is unavailable (ADR-0057).
	"vars": {
		"NUXT_BANDAI_KEEPR_API_URL": "https://op-api.keepr.digital"
	},
	"kv_namespaces": [{ "binding": "KV", "id": "a15cf281b12d43e4b5479baf8b69b587" }],
	"r2_buckets": [
		{
			"binding": "GRAPHICS_ASSET_STAGING",
			"bucket_name": "stream-graphics-asset-staging"
		},
		{
			"binding": "GRAPHICS_ASSET_CANONICAL",
			"bucket_name": "stream-graphics-asset-canonical"
		}
	],
	// Hourly: Graphics Asset Library retention and reconciliation. Deadlines are
	// evaluated inside the library, so this only needs to run often enough to
	// keep queues short. Every minute: Melee Live Results ticks for due Events.
	// Each handler keeps to its own cron (server/utils/cronSchedules.ts).
	"triggers": {
		"crons": ["17 * * * *", "* * * * *"]
	},
	"services": [
		{
			// Trusted silent-video playback validation runtime. Deploy the
			// validator first (pnpm deploy:validator) so this binding resolves.
			"binding": "SILENT_VIDEO_PLAYBACK_VALIDATOR",
			"service": "stream-silent-video-validator"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05,
			"persist": true
		}
	},
	// The Staging Installation (deploy.jsonc's `staging`), in the staging Cloudflare
	// account (ADR-0122): the same build, deployed with `--env staging`. Wrangler
	// does not inherit vars or bindings into an env block, so each is restated
	// with the staging account's ids; it inherits the rest (compatibility,
	// triggers, observability), and `routes`, which would carry production's
	// custom domain, is restated. `name` is set, or Wrangler deploys
	// `stream-staging`. test/unit/build/wranglerEnvironments.test.ts holds the
	// two to the same bindings.
	"env": {
		"staging": {
			"name": "stream",
			"routes": [{ "pattern": "stream.keepr-staging.digital", "custom_domain": true }],
			"durable_objects": { "bindings": [{ "name": "EVENT_REALTIME", "class_name": "EventRealtime" }] },
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "08191aa3-de28-4114-a2d6-81a907a68c41",
					"migrations_table": "_hub_migrations",
					"migrations_dir": "../../server/db/migrations/sqlite"
				}
			],
			"vars": {
				"NUXT_BANDAI_KEEPR_API_URL": "https://op-api.keepr.digital"
			},
			"kv_namespaces": [{ "binding": "KV", "id": "f38e3b36f6e5463794d5208ee373bef8" }],
			"r2_buckets": [
				{
					"binding": "GRAPHICS_ASSET_STAGING",
					"bucket_name": "stream-graphics-asset-staging"
				},
				{
					"binding": "GRAPHICS_ASSET_CANONICAL",
					"bucket_name": "stream-graphics-asset-canonical"
				}
			],
			"services": [
				{
					"binding": "SILENT_VIDEO_PLAYBACK_VALIDATOR",
					"service": "stream-silent-video-validator"
				}
			]
		}
	}
}
