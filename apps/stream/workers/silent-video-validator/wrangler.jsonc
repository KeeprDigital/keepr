{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "stream-silent-video-validator",
	// Production's account, as the app's config names it (ADR-0130); `env.staging` names its own.
	"account_id": "3ec389380c7b82e6a172e6f351d4aad9",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
	// Private service: reachable only through the SILENT_VIDEO_PLAYBACK_VALIDATOR
	// service binding on the stream Worker. No public URL is ever exposed.
	"workers_dev": false,
	"preview_urls": false,
	"r2_buckets": [
		{
			"binding": "GRAPHICS_ASSET_STAGING",
			"bucket_name": "stream-graphics-asset-staging"
		}
	],
	"workflows": [
		{
			"name": "silent-video-validation",
			"binding": "SILENT_VIDEO_VALIDATION_WORKFLOW",
			"class_name": "SilentVideoValidationWorkflow"
		}
	],
	"containers": [
		{
			"class_name": "SilentVideoValidationContainer",
			"image": "./container/Dockerfile",
			"instance_type": "standard-3",
			"max_instances": 4
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SILENT_VIDEO_VALIDATION_CONTAINER",
				"class_name": "SilentVideoValidationContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SilentVideoValidationContainer"]
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	},
	// The Staging Installation's validator, in the staging Cloudflare account
	// (ADR-0122), deployed with `--env staging`. Wrangler does not inherit
	// bindings, the Workflow, the Container or the Durable Object into an env
	// block, so each is restated; it inherits the Durable Object `migrations`,
	// which stay one list. `name` is set, or Wrangler deploys
	// `stream-silent-video-validator-staging`. Production's fingerprint resolves
	// without this block, so editing it never redeploys production's validator.
	"env": {
		"staging": {
			"name": "stream-silent-video-validator",
			"account_id": "98e3d208fbb975ce573938b72ed9e7b8",
			"r2_buckets": [
				{
					"binding": "GRAPHICS_ASSET_STAGING",
					"bucket_name": "stream-graphics-asset-staging"
				}
			],
			"workflows": [
				{
					"name": "silent-video-validation",
					"binding": "SILENT_VIDEO_VALIDATION_WORKFLOW",
					"class_name": "SilentVideoValidationWorkflow"
				}
			],
			"containers": [
				{
					// The name Wrangler gives production's, which it would otherwise suffix `-staging`.
					"name": "stream-silent-video-validator-silentvideovalidationcontainer",
					"class_name": "SilentVideoValidationContainer",
					"image": "./container/Dockerfile",
					"instance_type": "standard-3",
					"max_instances": 4
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "SILENT_VIDEO_VALIDATION_CONTAINER",
						"class_name": "SilentVideoValidationContainer"
					}
				]
			}
		}
	}
}
